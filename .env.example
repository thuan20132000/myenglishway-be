DEBUG=True
SECRET_KEY=insecure-dev-key-change-me
DATABASE_URL=postgres://localhost:5432/english_practice
ALLOWED_HOSTS=localhost,127.0.0.1
# Exact browser origins allowed to call the API. Add the deployed frontend here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Scheme required. Production: the public API URL and the frontend origin.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
# Google sign-in
# OAuth 2.0 Web client ID from the Google Cloud console. Public, not a secret.
GOOGLE_OAUTH_CLIENT_ID=

MAX_AUDIO_FILE_SIZE_MB=50
MAX_PDF_FILE_SIZE_MB=20
MAX_WRITING_PDF_FILE_SIZE_MB=60
MAX_WRITING_PAGE_LENGTH=20000
PRACTICE_COMPLETION_THRESHOLD=80.0

# Transcription
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
TRANSCRIPTION_AUTO_START=True
# OpenAI Whisper upload cap
TRANSCRIPTION_MAX_FILE_SIZE_MB=25

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 (production always; locally set USE_S3=True)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_QUERYSTRING_AUTH=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
