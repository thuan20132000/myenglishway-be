DEBUG=True
SECRET_KEY=insecure-dev-key-change-me
DATABASE_URL=postgres://localhost:5432/english_practice
ALLOWED_HOSTS=localhost,127.0.0.1
# Exact browser origins allowed to call the API. Add the deployed frontend here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_AUDIO_FILE_SIZE_MB=50
MAX_PDF_FILE_SIZE_MB=20
PRACTICE_COMPLETION_THRESHOLD=80.0

# Transcription
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
TRANSCRIPTION_AUTO_START=True
# OpenAI Whisper upload cap
TRANSCRIPTION_MAX_FILE_SIZE_MB=25

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
